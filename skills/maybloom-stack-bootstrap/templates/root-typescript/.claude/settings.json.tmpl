{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm test)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:proto)",
      "Bash(pnpm lint:ts)",
      "Bash(pnpm proto:gen)",
      "Bash(pnpm build)",
      "Bash(pnpm build:web)",
      "Bash(pnpm build:docs-site)",
      "Bash(pnpm --filter __ORG_SCOPE__/interface check:gallery)",
      "Bash(pnpm --filter __ORG_SCOPE__/protocol-buffers build)",
      "Bash(pnpm --filter __ORG_SCOPE__/docs-site build)",
      "Bash(pnpm --filter __ORG_SCOPE__/backend build)",
      "Bash(buf lint)",
      "Bash(pnpm --filter __ORG_SCOPE__/backend typecheck)",
      "Bash(pnpm --filter __ORG_SCOPE__/backend db:generate)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-budget.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "maybloom-stack": {
      "source": {
        "source": "github",
        "repo": "MaybloomTech/maybloom-stack"
      }
    },
    "expo-plugins": {
      "source": {
        "source": "github",
        "repo": "expo/skills"
      }
    }
  },
  "enabledPlugins": {
    "maybloom-stack@maybloom-stack": true,
    "expo@expo-plugins": true
  }
}
