import { create } from "@bufbuild/protobuf";
import type { MethodImpl } from "@connectrpc/connect";
import { __APP_NAME__Service } from "__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/service/v1/service_pb";
import { GetNoteResponseSchema } from "__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/service/v1/notes_pb";
import { getNote as getNoteCore } from "core/notes/store";

export type GetNoteMethod = typeof __APP_NAME__Service.method.getNote;

export const getNote: MethodImpl<GetNoteMethod> = async (request) => {
  const note = await getNoteCore(request.id);
  return create(GetNoteResponseSchema, { note });
};
