import { create } from "@bufbuild/protobuf";
import type { MethodImpl } from "@connectrpc/connect";
import { __APP_NAME__Service } from "__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/service/v1/service_pb";
import { ListNotesResponseSchema } from "__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/service/v1/notes_pb";
import { listNotes as listNotesCore } from "core/notes/store";

export type ListNotesMethod = typeof __APP_NAME__Service.method.listNotes;

export const listNotes: MethodImpl<ListNotesMethod> = async () => {
  const notes = await listNotesCore();
  return create(ListNotesResponseSchema, { notes });
};
