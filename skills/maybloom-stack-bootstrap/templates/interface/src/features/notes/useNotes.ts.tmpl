import type { Note } from '__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/resources/v1/notes_pb';
import { useCallback, useEffect, useState } from 'react';
import { useBackend } from '../../data/client';

export type NotesState = {
  notes: Note[];
  /** True until the first answer. */
  loading: boolean;
  error: string | null;
  /** Ask again; the list on screen stays until the answer comes. */
  reload: () => void;
  /** Rejects when the save fails, so the form can say so. */
  create: (input: { title: string; body: string }) => Promise<void>;
  /** The id being archived, if any. */
  archiving: string | null;
  archive: (id: string) => Promise<void>;
};

const errorMessage = (err: unknown) =>
  err instanceof Error ? err.message : String(err);

// The notes page's data, hand-written over the Backend context: no cache
// library, one hook per feature. It reads the first page only: the example
// screen has no scroll-to-load. A mutation calls the client and then reloads
// the list, so what is on screen is what the server answered.
//
// A screen that pages the list reads like this instead (the shape of a
// scroll-to-load hook, over the same ListNotes):
//
//   const next = useRef('');       // the next page's token ('' before the first)
//   const busy = useRef(false);    // a call is in flight
//   const run = useRef(0);         // which run of the hook an answer belongs to
//   const [hasMore, setHasMore] = useState(true);
//
//   const fetchPage = useCallback((token: string) => {
//     if (busy.current) return;
//     busy.current = true;
//     const mine = run.current;
//     api.listNotes({ pageSize: 50, pageToken: token }).then((res) => {
//       if (run.current !== mine) return;   // the screen stopped wanting it
//       next.current = res.nextPageToken;
//       setHasMore(res.nextPageToken !== '');
//       setNotes((prev) => {
//         if (token === '') return res.notes;
//         // De-dupe: a note can come again when the list shifts under the
//         // reader; the later copy is the current one.
//         const fresh = new Set(res.notes.map((n) => n.id));
//         return [...prev.filter((n) => !fresh.has(n.id)), ...res.notes];
//       });
//     }).catch(...).finally(() => {
//       if (run.current !== mine) return;
//       busy.current = false;
//     });
//   }, [api]);
//
//   useEffect(() => {
//     fetchPage('');
//     return () => {           // a new run: drop what is in flight, start over
//       run.current += 1;
//       next.current = '';
//       busy.current = false;
//     };
//   }, [fetchPage]);
//
//   const loadMore = useCallback(() => {
//     if (next.current !== '') fetchPage(next.current);
//   }, [fetchPage]);
//
// and returns `loadMore` and `hasMore` for the list's onEndReached.
export function useNotes(): NotesState {
  const { __APP_SLUG__: api } = useBackend();
  const [notes, setNotes] = useState<Note[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [archiving, setArchiving] = useState<string | null>(null);
  // Bumped by reload(); the effect below runs again for each value.
  const [version, setVersion] = useState(0);

  useEffect(() => {
    // `version` is the effect's trigger: reload() bumps it.
    void version;
    let cancelled = false;
    api
      .listNotes({ pageSize: 50, pageToken: '' })
      .then((res) => {
        if (cancelled) return;
        setNotes(res.notes);
        setError(null);
      })
      .catch((err) => {
        if (cancelled) return;
        setError(errorMessage(err));
      })
      .finally(() => {
        if (cancelled) return;
        setLoading(false);
      });
    return () => {
      cancelled = true;
    };
  }, [api, version]);

  const reload = useCallback(() => setVersion((v) => v + 1), []);

  const create = useCallback(
    async (input: { title: string; body: string }) => {
      await api.createNote({ note: input });
      reload();
    },
    [api, reload],
  );

  const archive = useCallback(
    async (id: string) => {
      setArchiving(id);
      try {
        await api.archiveNote({ id });
        reload();
      } catch (err) {
        setError(errorMessage(err));
      } finally {
        setArchiving(null);
      }
    },
    [api, reload],
  );

  return { notes, loading, error, reload, create, archiving, archive };
}
