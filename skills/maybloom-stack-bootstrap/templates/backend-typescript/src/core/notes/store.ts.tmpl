import { randomUUID } from 'node:crypto';
import { Code, ConnectError } from '@connectrpc/connect';
import type { Note } from '__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/resources/v1/notes_pb';
import { noteRowToProto, noteToInsert, noteToUpdate } from 'core/notes/adapter';
import { notes } from 'db/schema';
import {
  and,
  desc,
  eq,
  getTableColumns,
  isNull,
  lt,
  or,
  type SQL,
  sql,
} from 'drizzle-orm';
import { internalError } from 'rpcerr';
import { server } from 'server';

// Stores hold the actual business logic for a resource. Handlers should be
// thin wrappers around store functions: handlers extract auth context and
// shape the proto response, stores do the real work. Stores speak the
// contract's error codes directly. Presence and ranges are the validate
// interceptor's (the contract's buf.validate rules), so nothing here checks
// them again.

const DEFAULT_PAGE = 50;
const MAX_PAGE = 200;

// Every database call is wrapped: the driver's message is the cause, logged
// by the error interceptor, and the client reads the public text.
async function query<T>(
  publicMessage: string,
  run: () => Promise<T>,
): Promise<T> {
  try {
    return await run();
  } catch (error) {
    throw internalError(publicMessage, error);
  }
}

export async function createNote(createdBy: string, input: Note) {
  const id = randomUUID();
  const [row] = await query('could not create the note', () =>
    server.db
      .insert(notes)
      .values(noteToInsert(input, id, createdBy))
      .returning(),
  );
  return noteRowToProto(row);
}

// Replaces title and body; the server keeps the rest (archived_at is
// archiveNote's).
export async function updateNote(input: Note) {
  const [row] = await query('could not update the note', () =>
    server.db
      .update(notes)
      .set({ ...noteToUpdate(input), updatedAt: new Date() })
      .where(eq(notes.id, input.id))
      .returning(),
  );
  if (!row) {
    throw new ConnectError('Note not found', Code.NotFound);
  }
  return noteRowToProto(row);
}

// Sets archived_at (kept if already set) and leaves the row in place;
// listNotes leaves it out unless asked. This is the example's answer to how
// a note leaves the default view, one of several a resource may give. The
// mirror, unarchiveNote (archivedAt: null), is added when a screen needs it.
export async function archiveNote(id: string) {
  const [row] = await query('could not archive the note', () =>
    server.db
      .update(notes)
      .set({
        archivedAt: sql`coalesce(${notes.archivedAt}, now())`,
        updatedAt: new Date(),
      })
      .where(eq(notes.id, id))
      .returning(),
  );
  if (!row) {
    throw new ConnectError('Note not found', Code.NotFound);
  }
  return noteRowToProto(row);
}

export async function getNote(id: string) {
  const [row] = await query('could not read the note', () =>
    server.db.select().from(notes).where(eq(notes.id, id)),
  );
  if (!row) {
    throw new ConnectError('Note not found', Code.NotFound);
  }
  return noteRowToProto(row);
}

export interface NoteFilter {
  pageSize: number;
  pageToken: string;
  includeArchived: boolean;
}

// Cursor paging, newest first, keyset on (created_at, id): the token is the
// keyset of the last row, opaque to the client, so a note created between
// two pages cannot shift the rest the way an offset would. The query asks for
// one row more than the page to learn whether another page follows.
//
// The cursor carries created_at as microseconds since the epoch, computed by
// the database (a JS Date keeps milliseconds and would skip or repeat the
// rows that share one; the text form depends on the session's DateStyle and
// TimeZone). The Go path's token has the same shape, in nanoseconds.
export async function listNotes(filter: NoteFilter) {
  const size = Math.min(
    filter.pageSize > 0 ? filter.pageSize : DEFAULT_PAGE,
    MAX_PAGE,
  );
  const before = decodePageToken(filter.pageToken);
  const rows = await query('could not list the notes', () =>
    server.db
      .select({
        ...getTableColumns(notes),
        cursor: sql<string>`(extract(epoch from ${notes.createdAt}) * 1000000)::bigint::text`,
      })
      .from(notes)
      .where(
        and(
          filter.includeArchived ? undefined : isNull(notes.archivedAt),
          before
            ? or(
                lt(notes.createdAt, before.createdAt),
                and(
                  eq(notes.createdAt, before.createdAt),
                  lt(notes.id, before.id),
                ),
              )
            : undefined,
        ),
      )
      .orderBy(desc(notes.createdAt), desc(notes.id))
      .limit(size + 1),
  );
  const page = rows.slice(0, size);
  const last = page[page.length - 1];
  return {
    notes: page.map(({ cursor: _cursor, ...row }) => noteRowToProto(row)),
    nextPageToken:
      rows.length > size && last ? encodePageToken(last.cursor, last.id) : '',
  };
}

// What this service issues: "<microseconds>:<uuid>", base64url. Anything
// else is refused here with InvalidArgument rather than by the database.
const PAGE_TOKEN = /^(\d{1,19}):([0-9a-fA-F-]{36})$/;

function encodePageToken(micros: string, id: string): string {
  return Buffer.from(`${micros}:${id}`).toString('base64url');
}

function decodePageToken(
  token: string,
): { createdAt: SQL; id: string } | undefined {
  if (!token) {
    return undefined;
  }
  const match = PAGE_TOKEN.exec(Buffer.from(token, 'base64url').toString());
  if (!match) {
    throw new ConnectError(
      'page_token is not one this service issued',
      Code.InvalidArgument,
    );
  }
  const [, micros, id] = match;
  // Exact: an integer number of microseconds added to the epoch, never a
  // float through to_timestamp.
  return {
    createdAt: sql`'epoch'::timestamptz + ${micros}::bigint * interval '1 microsecond'`,
    id,
  };
}
