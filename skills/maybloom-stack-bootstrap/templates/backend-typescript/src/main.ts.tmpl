import { createContextValues, type ServiceImpl } from "@connectrpc/connect";
import { fastifyConnectPlugin } from "@connectrpc/connect-fastify";
import { __APP_NAME__Service } from "__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/service/v1/service_pb";
import { routes } from "routes";
import { kRequestId, kUserId } from "context";
import { bootstrapServer } from "server";
import { createAuthInterceptor } from "auth";
import { errorInterceptor } from "rpcerr";
import { validateInterceptor } from "validate";
import { archiveNote } from "handlers/archiveNote";
import { createNote } from "handlers/createNote";
import { updateNote } from "handlers/updateNote";
import { getNote } from "handlers/getNote";
import { listNotes } from "handlers/listNotes";
import { health } from "handlers/health";

bootstrapServer(async (app) => {
  // Map every RPC declared in service.proto to a handler. Adding a new RPC is
  // a four-step dance: declare it in the proto, regen, write a handler, and
  // wire it in here. The TypeScript compiler will refuse to build until the
  // shape of this object matches the service definition. The interceptors
  // run in the Go path's order: errors outermost (nothing but a ConnectError
  // reaches the wire, the cause goes to the log), auth gates (Health open),
  // then validate enforces the contract's buf.validate rules, so handlers
  // and stores check neither the caller nor anything the contract states.
  const __APP_SLUG__Service: ServiceImpl<typeof __APP_NAME__Service> = {
    health,
    createNote,
    updateNote,
    archiveNote,
    getNote,
    listNotes,
  };

  await app.register(fastifyConnectPlugin, {
    routes: (router) => {
      router.service(__APP_NAME__Service, __APP_SLUG__Service);
    },
    interceptors: [errorInterceptor, createAuthInterceptor([__APP_NAME__Service.method.health]), validateInterceptor],
    // Who is calling and which request this is, for every handler. The
    // request id is Fastify's (server.ts: the caller's X-Request-Id when it
    // has the shape, a fresh one otherwise; on every log line and echoed on
    // the response). The identity is the development user until a real
    // credential is read here (server.ts holds the rule that refuses to
    // boot without one).
    contextValues: (req) => {
      const contextValues = createContextValues();
      contextValues.set(kRequestId, req.id);
      contextValues.set(kUserId, app.config.DEV_USER ?? "");
      return contextValues;
    },
  });

  await app.register(routes);
});
