import { create } from "@bufbuild/protobuf";
import { Code, ConnectError, type MethodImpl } from "@connectrpc/connect";
import { __APP_NAME__Service } from "__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/service/v1/service_pb";
import { ArchiveNoteResponseSchema } from "__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/service/v1/notes_pb";
import { kUserId } from "context";
import { archiveNote as archiveNoteCore } from "core/notes/store";

export type ArchiveNoteMethod = typeof __APP_NAME__Service.method.archiveNote;

// A verb RPC: the example's answer to how a note leaves the default view.
// The id is a uuid by the contract (validated before this runs); the store
// answers NotFound for an unknown one.
export const archiveNote: MethodImpl<ArchiveNoteMethod> = async (request, context) => {
  if (!context.values.get(kUserId)) {
    throw new ConnectError("sign in first", Code.Unauthenticated);
  }
  const note = await archiveNoteCore(request.id);
  return create(ArchiveNoteResponseSchema, { note });
};
