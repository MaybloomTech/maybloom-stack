import { create } from "@bufbuild/protobuf";
import { Code, ConnectError, type MethodImpl } from "@connectrpc/connect";
import { __APP_NAME__Service } from "__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/service/v1/service_pb";
import { CreateNoteResponseSchema } from "__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/service/v1/notes_pb";
import { kUserId } from "context";
import { createNote as createNoteCore } from "core/notes/store";

export type CreateNoteMethod = typeof __APP_NAME__Service.method.createNote;

export const createNote: MethodImpl<CreateNoteMethod> = async (
  request,
  context,
) => {
  // `required` in the contract; the validate interceptor has refused a
  // missing note already, this narrows the type.
  const noteInput = request.note;
  if (!noteInput) {
    throw new ConnectError("Note is required", Code.InvalidArgument);
  }
  // created_by is the caller, never the client's word for it, and a request
  // with no caller is refused rather than written as anyone.
  const createdBy = context.values.get(kUserId);
  if (!createdBy) {
    throw new ConnectError("sign in first", Code.Unauthenticated);
  }
  const note = await createNoteCore(createdBy, noteInput);
  return create(CreateNoteResponseSchema, { note });
};
