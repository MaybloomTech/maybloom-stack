import { create } from "@bufbuild/protobuf";
import { Code, ConnectError, type MethodImpl } from "@connectrpc/connect";
import { __APP_NAME__Service } from "__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/service/v1/service_pb";
import { UpdateNoteResponseSchema } from "__ORG_SCOPE__/protocol-buffers/__APP_SLUG__/service/v1/notes_pb";
import { updateNote as updateNoteCore } from "core/notes/store";

export type UpdateNoteMethod = typeof __APP_NAME__Service.method.updateNote;

export const updateNote: MethodImpl<UpdateNoteMethod> = async (request) => {
  if (!request.note) {
    throw new ConnectError("Note is required", Code.InvalidArgument);
  }
  const note = await updateNoteCore(request.note, request.archived);
  return create(UpdateNoteResponseSchema, { note });
};
