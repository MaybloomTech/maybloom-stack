HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
ENVIRONMENT=local
# Development only: every request is this user. Production refuses it and
# needs a real identity set in src/main.ts (contextValues).
DEV_USER=dev

# Dev default: in-process Postgres via PGlite, persisted to a local folder.
# No Docker, no Postgres install required.
DATABASE_URL=pglite://./.dev-db/__APP_SLUG__
# In-memory (resets each boot):
# DATABASE_URL=pglite-memory://
# Real Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/__APP_SLUG__
