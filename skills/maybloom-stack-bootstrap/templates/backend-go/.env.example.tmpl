# Every setting the backend reads, validated at boot (internal/config). The
# binary reads the process environment only: compose supplies these in
# production, `pnpm dev:backend` passes the development ones inline.
ADDR=:8080
# production or development; production refuses DEV_USER and an http PUBLIC_URL.
ENVIRONMENT=development
PUBLIC_URL=http://localhost:8080
# pgx pool URL. Migrations run against it on boot.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/__APP_SLUG__
# Development only: every request is this user, no identity provider needed.
DEV_USER=dev
# Browser origins allowed to call the API from another origin, comma-separated
# (the Expo dev server). Empty in production: the web export is served from
# the API's own origin.
CORS_ORIGINS=http://localhost:8081
# json or text; empty picks json in production, text otherwise.
LOG_FORMAT=
MAX_REQUEST_BYTES=1048576
