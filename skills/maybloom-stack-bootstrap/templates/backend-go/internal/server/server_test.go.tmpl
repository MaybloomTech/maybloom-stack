// RPC tests go through the generated connect-go client against the real mux,
// so the interceptor chain is under test too. A request built by hand with
// connect.NewRequest carries an empty Spec(), which is why the client, not
// the handler methods, is the entry point.

// anonymous is an Authenticator that knows nobody.
type anonymous struct{}

func (anonymous) Authenticate(context.Context, http.Header) (*auth.Identity, error) { return nil, nil }

func newClient(t *testing.T, d Deps) servicev1connect.__APP_NAME__ServiceClient {
	t.Helper()
	if d.Log == nil {
		d.Log = slog.New(slog.DiscardHandler)
	}
	srv := httptest.NewServer(NewMux(d))
	t.Cleanup(srv.Close)
	return servicev1connect.New__APP_NAME__ServiceClient(srv.Client(), srv.URL)
}

// The interceptors need no database: Health is open, validate refuses a bad
// request before any handler, and the gate refuses the anonymous.
func TestInterceptors(t *testing.T) {
	t.Parallel()
	ctx := t.Context()
	client := newClient(t, Deps{Authenticator: anonymous{}})

	health, err := client.Health(ctx, connect.NewRequest(&servicev1.HealthRequest{}))
	if err != nil || !health.Msg.GetOk() || health.Msg.GetVersion() == "" {
		t.Fatalf("health: %v %v", health, err)
	}
	if health.Header().Get(requestIDHeader) == "" {
		t.Fatal("the response carries no X-Request-Id")
	}

	_, err = client.ListNotes(ctx, connect.NewRequest(&servicev1.ListNotesRequest{}))
	if connect.CodeOf(err) != connect.CodeUnauthenticated {
		t.Fatalf("anonymous list: want CodeUnauthenticated, got %v", err)
	}

	signedIn := newClient(t, Deps{Authenticator: auth.DevAuthenticator{UserID: "tester"}})
	_, err = signedIn.CreateNote(ctx, connect.NewRequest(&servicev1.CreateNoteRequest{Note: &resourcesv1.Note{Title: ""}}))
	if connect.CodeOf(err) != connect.CodeInvalidArgument {
		t.Fatalf("empty title: want CodeInvalidArgument from the validate interceptor, got %v", err)
	}
	_, err = signedIn.CreateNote(ctx, connect.NewRequest(&servicev1.CreateNoteRequest{}))
	if connect.CodeOf(err) != connect.CodeInvalidArgument {
		t.Fatalf("missing note: want CodeInvalidArgument (required), got %v", err)
	}
	_, err = signedIn.ListNotes(ctx, connect.NewRequest(&servicev1.ListNotesRequest{PageSize: 500}))
	if connect.CodeOf(err) != connect.CodeInvalidArgument {
		t.Fatalf("page_size over the cap: want CodeInvalidArgument, got %v", err)
	}
}

// The Note loop over the wire: create, list, get, update, archive. Needs
// TEST_DATABASE_URL and skips without it.
func TestNoteLoop(t *testing.T) {
	url := os.Getenv("TEST_DATABASE_URL")
	if url == "" {
		t.Skip("TEST_DATABASE_URL not set")
	}
	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
	defer cancel()
	pool, err := postgres.Open(ctx, url)
	if err != nil {
		t.Fatalf("open: %v", err)
	}
	t.Cleanup(pool.Close)
	client := newClient(t, Deps{Store: store.New(pool), Authenticator: auth.DevAuthenticator{UserID: "tester"}})

	created, err := client.CreateNote(ctx, connect.NewRequest(&servicev1.CreateNoteRequest{Note: &resourcesv1.Note{Title: "Over the wire", CreatedBy: "spoofed"}}))
	if err != nil {
		t.Fatalf("create: %v", err)
	}
	note := created.Msg.GetNote()
	if note.GetCreatedBy() != "tester" {
		t.Fatalf("created_by must come from the identity, got %q", note.GetCreatedBy())
	}

	listed, err := client.ListNotes(ctx, connect.NewRequest(&servicev1.ListNotesRequest{PageSize: 1}))
	if err != nil || len(listed.Msg.GetNotes()) != 1 || listed.Msg.GetNotes()[0].GetId() != note.GetId() {
		t.Fatalf("list: the new note should be first, got %v %v", listed, err)
	}

	got, err := client.GetNote(ctx, connect.NewRequest(&servicev1.GetNoteRequest{Id: note.GetId()}))
	if err != nil || got.Msg.GetNote().GetTitle() != "Over the wire" {
		t.Fatalf("get: %v %v", got, err)
	}

	note.Title = "Edited over the wire"
	updated, err := client.UpdateNote(ctx, connect.NewRequest(&servicev1.UpdateNoteRequest{Note: note}))
	if err != nil || updated.Msg.GetNote().GetTitle() != "Edited over the wire" || updated.Msg.GetNote().GetUpdatedAt() == nil {
		t.Fatalf("update: %v %v", updated, err)
	}

	archived, err := client.UpdateNote(ctx, connect.NewRequest(&servicev1.UpdateNoteRequest{Note: note, Archived: true}))
	if err != nil || archived.Msg.GetNote().GetArchivedAt() == nil {
		t.Fatalf("archive: %v %v", archived, err)
	}
	after, err := client.GetNote(ctx, connect.NewRequest(&servicev1.GetNoteRequest{Id: note.GetId()}))
	if err != nil || after.Msg.GetNote().GetArchivedAt() == nil {
		t.Fatalf("an archived note must still be readable by id: %v %v", after, err)
	}

	_, err = client.GetNote(ctx, connect.NewRequest(&servicev1.GetNoteRequest{Id: "00000000-0000-0000-0000-000000000000"}))
	if connect.CodeOf(err) != connect.CodeNotFound {
		t.Fatalf("unknown id: want CodeNotFound, got %v", err)
	}
}
