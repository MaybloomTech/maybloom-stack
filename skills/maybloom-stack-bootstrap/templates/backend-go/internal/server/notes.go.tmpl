package server

import (
	"context"

	"connectrpc.com/connect/v2"

	servicev1 "__GO_MODULE__/gen/__APP_SLUG__/service/v1"
	"__GO_MODULE__/internal/auth"
	"__GO_MODULE__/internal/store"
)

// The Note handlers: read the identity the interceptor put on the context,
// call the store, return the answer as the plain response message. Presence
// and ranges are the validate interceptor's (the contract's buf.validate
// rules), so there is nothing left to check here; a handler past twenty lines
// is logic leaking in.

// caller is the identity the auth interceptor put on the context. The gate
// already refused the anonymous, so the nil case is a wiring mistake (the
// procedure on the open list, the interceptor missing from the chain), and a
// handler that writes created_by still refuses it rather than writing "".
func caller(ctx context.Context) (*auth.Identity, error) {
	id := auth.IdentityFrom(ctx)
	if id == nil {
		return nil, connect.NewError(connect.CodeUnauthenticated, "sign in first")
	}
	return id, nil
}

func (s *Service) CreateNote(ctx context.Context, req *servicev1.CreateNoteRequest) (*servicev1.CreateNoteResponse, error) {
	id, err := caller(ctx)
	if err != nil {
		return nil, err
	}
	note, err := s.store.CreateNote(ctx, id.UserID, req.GetNote())
	if err != nil {
		return nil, err
	}
	s.log.Info("note created", "user", id.UserID, "note", note.GetId())
	return &servicev1.CreateNoteResponse{Note: note}, nil
}

func (s *Service) GetNote(ctx context.Context, req *servicev1.GetNoteRequest) (*servicev1.GetNoteResponse, error) {
	note, err := s.store.GetNote(ctx, req.GetId())
	if err != nil {
		return nil, err
