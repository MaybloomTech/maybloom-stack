	return &servicev1.GetNoteResponse{Note: note}, nil
}

func (s *Service) ListNotes(ctx context.Context, req *servicev1.ListNotesRequest) (*servicev1.ListNotesResponse, error) {
	page, err := s.store.ListNotes(ctx, store.NoteFilter{
		PageSize:        int(req.GetPageSize()),
		PageToken:       req.GetPageToken(),
		IncludeArchived: req.GetIncludeArchived(),
	})
	if err != nil {
		return nil, err
	}
	return &servicev1.ListNotesResponse{Notes: page.Notes, NextPageToken: page.NextPageToken}, nil
}

