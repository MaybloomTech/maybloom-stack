// Package auth is the identity seam: who is calling, resolved once per RPC by
// the interceptor and read by handlers from the context. The scaffold ships
// one Authenticator, the development identity; a real one (an OIDC client
// against the deployment's identity provider, bearer tokens the service
// mints) is the project's first auth decision and lives beside it here.
package auth

import (
	"context"
	"errors"
	"net/http"

	"connectrpc.com/connect"

	"__GO_MODULE__/internal/rpcerr"
)

// Identity is the caller. UserID is what stores write into created_by.
type Identity struct {
	UserID string
	Name   string
}

// Authenticator resolves the caller from the request headers. nil, nil means
// anonymous; an error means the check itself failed (CodeInternal), not that
// the caller is unknown.
type Authenticator interface {
	Authenticate(ctx context.Context, header http.Header) (*Identity, error)
}

// DevAuthenticator makes every request the named user. Development only; the
// config refuses it in production.
type DevAuthenticator struct {
	UserID string
}

func (d DevAuthenticator) Authenticate(context.Context, http.Header) (*Identity, error) {
	return &Identity{UserID: d.UserID, Name: d.UserID}, nil
}

type identityKey struct{}

// WithIdentity puts the caller on the context; the interceptor does this.
func WithIdentity(ctx context.Context, id *Identity) context.Context {
	return context.WithValue(ctx, identityKey{}, id)
}

// IdentityFrom reads the caller the interceptor put on the context; nil when
// the RPC was open and the caller anonymous.
func IdentityFrom(ctx context.Context) *Identity {
	id, _ := ctx.Value(identityKey{}).(*Identity)
	return id
}

// Interceptor gates: it resolves the caller on every RPC, unary and
// streaming, and rejects anonymous calls with CodeUnauthenticated, except for
// the procedures in open (the health check). The alternative shape, which
// populates and lets each handler assert, fits a service whose anonymous
// RPCs are a feature.
//
// It is a full connect.Interceptor on purpose: a UnaryInterceptorFunc is not
// applied to streaming RPCs, so the first stream in the contract would be
// open to everyone.
func Interceptor(a Authenticator, open ...string) connect.Interceptor {
	openSet := make(map[string]bool, len(open))
	for _, p := range open {
		openSet[p] = true
	}
	return interceptor{a: a, open: openSet}
}

type interceptor struct {
	a    Authenticator
	open map[string]bool
}

func (i interceptor) WrapUnary(next connect.UnaryFunc) connect.UnaryFunc {
	return func(ctx context.Context, req connect.AnyRequest) (connect.AnyResponse, error) {
		ctx, err := i.authenticate(ctx, req.Header(), req.Spec().Procedure)
		if err != nil {
			return nil, err
		}
		return next(ctx, req)
	}
}

func (i interceptor) WrapStreamingHandler(next connect.StreamingHandlerFunc) connect.StreamingHandlerFunc {
	return func(ctx context.Context, conn connect.StreamingHandlerConn) error {
		ctx, err := i.authenticate(ctx, conn.RequestHeader(), conn.Spec().Procedure)
		if err != nil {
			return err
		}
		return next(ctx, conn)
	}
}

// WrapStreamingClient is the identity: the server makes no outbound RPCs.
func (interceptor) WrapStreamingClient(next connect.StreamingClientFunc) connect.StreamingClientFunc {
	return next
}

// authenticate is the gate itself, shared by both RPC shapes: the identity on
// the context, or the error that refuses the call. Errors are made here, per
// call, because the RequestID interceptor writes into an error's Meta.
func (i interceptor) authenticate(ctx context.Context, header http.Header, procedure string) (context.Context, error) {
	id, err := i.a.Authenticate(ctx, header)
	if err != nil {
		// The provider's message (a token endpoint's body, a network error)
		// is for the log, never for the caller.
		return ctx, rpcerr.Internal("could not resolve the caller", err)
	}
	if id == nil && !i.open[procedure] {
		return ctx, connect.NewError(connect.CodeUnauthenticated, errors.New("sign in first"))
	}
	if id != nil {
		ctx = WithIdentity(ctx, id)
	}
	return ctx, nil
}
