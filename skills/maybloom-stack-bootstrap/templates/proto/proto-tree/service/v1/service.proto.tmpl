syntax = "proto3";

package __APP_SLUG__.service.v1;

import "__APP_SLUG__/service/v1/health.proto";
import "__APP_SLUG__/service/v1/notes.proto";

option go_package = "__GO_MODULE__/gen/__APP_SLUG__/service/v1;servicev1";

// The single Connect-RPC service for __APP_NAME__. Layout: resources/v1 holds
// the nouns, common/v1 holds value types once two resources share one,
// service/v1 holds one envelope file per resource plus this file. Add new RPCs
// here, grouped by resource under comment headers, as they arrive.
service __APP_NAME__Service {
  // Backend
  rpc Health(HealthRequest) returns (HealthResponse);

  // Notes
  rpc CreateNote(CreateNoteRequest) returns (CreateNoteResponse);
  rpc GetNote(GetNoteRequest) returns (GetNoteResponse);
  rpc ListNotes(ListNotesRequest) returns (ListNotesResponse);
  rpc UpdateNote(UpdateNoteRequest) returns (UpdateNoteResponse);
  rpc ArchiveNote(ArchiveNoteRequest) returns (ArchiveNoteResponse);
}
