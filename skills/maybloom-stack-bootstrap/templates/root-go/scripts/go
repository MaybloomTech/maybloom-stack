#!/usr/bin/env bash
# Run a Go toolchain command for the go/ module inside the pinned golang image,
# for a machine with no Go installed (a deploy host that builds everything in
# Docker, a laptop that would rather not). Module and build caches live in
# named volumes so the second run is fast. Usage, from anywhere in the repo:
#
#   scripts/go build ./...
#   scripts/go test ./...
#   scripts/go generate .
#
# GO_IMAGE overrides the image. Its patch is pinned with go.mod's go line and
# go/Dockerfile's FROM; GOTOOLCHAIN=local makes a mismatch fail loudly instead
# of downloading another toolchain. Raise the three together.
# GO_DOCKER_ARGS adds docker run flags (a --network for the database, a -p to
# publish the port); the backend's settings (DATABASE_URL, DEV_USER, ... and
# TEST_DATABASE_URL) pass through when set, so `DEV_USER=dev scripts/go run
# ./cmd/<slug>` means what it says. The root package.json's dev:backend and
# test:backend are this script joined to the compose network.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GO_IMAGE="${GO_IMAGE:-golang:1.26.7-alpine}"
PROJECT="$(basename "${REPO_ROOT}")"

# A named volume is root-owned when Docker creates it, and the container runs
# as the invoking user, so each cache volume is created once here and handed
# to that user before its first use.
ensure_volume() {
  if ! docker volume inspect "$1" >/dev/null 2>&1; then
    docker volume create "$1" >/dev/null
    docker run --rm -v "$1:/mnt" "${GO_IMAGE}" chown "$(id -u):$(id -g)" /mnt
  fi
}
ensure_volume "${PROJECT}-gomodcache"
ensure_volume "${PROJECT}-gocache"
ensure_volume "${PROJECT}-gohome"

# The backend's settings, when set in the calling shell. (The expansion below
# is the bash 3 spelling of "the array, or nothing": macOS ships bash 3.2 and
# `set -u` there treats an empty array as unbound.)
PASS_ENV=()
for v in ADDR ENVIRONMENT PUBLIC_URL DATABASE_URL DEV_USER CORS_ORIGINS LOG_FORMAT LOG_LEVEL MAX_REQUEST_BYTES TEST_DATABASE_URL; do
  if [ -n "${!v-}" ]; then PASS_ENV+=(-e "$v"); fi
done

# A terminal when run from one, so Ctrl-C reaches the process (`go run` and
# the binary under it); --init puts an init process at PID 1 to forward the
# signal and reap. Piped runs (CI, scripts) get no tty.
TTY=()
if [ -t 0 ] && [ -t 1 ]; then TTY=(-t); fi

# Files the toolchain writes (go.sum, generated code) must belong to the
# invoking user, not root, so the container runs as that uid with writable
# caches of its own.
exec docker run --rm -i --init ${TTY[@]+"${TTY[@]}"} \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp/gohome -e GOCACHE=/tmp/gocache -e GOFLAGS=-buildvcs=false -e GOTOOLCHAIN=local \
  ${PASS_ENV[@]+"${PASS_ENV[@]}"} \
  ${GO_DOCKER_ARGS-} \
  -v "${PROJECT}-gomodcache:/go/pkg" \
  -v "${PROJECT}-gocache:/tmp/gocache" \
  -v "${PROJECT}-gohome:/tmp/gohome" \
  -v "${REPO_ROOT}:/src" \
  -w /src/go \
  "${GO_IMAGE}" go "$@"
