---
// Self-hosted fonts, the Maybloom family DNA: Source Serif 4 for display,
// Inter Tight for text and labels, IBM Plex Mono for code only.
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/500.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/500-italic.css';
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import ThemeScript from '~/components/ThemeScript.astro';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (the 404 page, served at any URL). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const siteName = 'The Maybloom Stack';
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const desc =
  description ??
  'A schema-first monorepo stack: protobuf contracts, Connect-RPC, and a choice of TypeScript or Go on the backend.';

// Analytics is build-time configuration, never committed. Both variables have
// to be set for the tag to render, so a fork builds a site that reports
// nothing to anyone rather than silently reporting to whoever built it last.
const analyticsScript = import.meta.env.PUBLIC_ANALYTICS_SCRIPT_URL;
const analyticsSiteId = import.meta.env.PUBLIC_ANALYTICS_SITE_ID;
const analyticsEnabled = Boolean(analyticsScript && analyticsSiteId);
---
<!doctype html>
<html lang="en" data-theme="studio">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#eceeec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111815" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Set the saved theme before paint to avoid a flash of the wrong skin. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('mb_stack_theme') || 'studio';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />

    {analyticsEnabled && (
      <script is:inline defer src={analyticsScript} data-website-id={analyticsSiteId}></script>
    )}
  </head>
  <body>
    <Header />
    <slot />
    <footer class="site-footer">
      <div class="frame">
        <hr class="rule" />
        <p>
          Extracted from a working production system.
          <a href="https://github.com/MaybloomTech/maybloom-stack">Source on GitHub</a>.
          Tended by <a href="https://maybloom.tech">Maybloom</a>.
        </p>
      </div>
    </footer>
    <ThemeScript />
  </body>
</html>
