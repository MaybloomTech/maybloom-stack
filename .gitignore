# Deliberately narrow: a broad `.env.*` pattern would swallow the
# `.env.example.tmpl` files the bootstrap skill ships as templates.
node_modules/
dist/
.astro/
.env
.env.local
.DS_Store
*.log

# Tool scratch directories. These are written into automatically, so they
# are ignored rather than merely untracked: an untracked directory is one
# `git add -A` away from being published.
.playwright-mcp/
